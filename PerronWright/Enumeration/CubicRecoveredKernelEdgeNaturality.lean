import PerronWright.Enumeration.CubicGlobalPresentationAlignedCast

/-!
# Naturality of recovered cubic-kernel edge coordinates

The recovered edge coordinate is defined through the intrinsic suppressed-edge
type: a positive-length edge is represented by a connected component of the
degree-two graph, while a zero-length edge is represented by its actual direct
branch edge.  This file proves that this intrinsic representation is natural
under simultaneous kernel-coordinate relabelling and under the dependent cast
used by the global presentation decoder.

The proof deliberately works with the two summands of `KernelEdgeLabel`.
Endpoint pairs and lengths alone would not distinguish parallel positive-length
kernel edges.
-/

noncomputable section

namespace PerronWright.GraphCore

open scoped Classical

/-- Equality transport carries the component generated by a degree-two vertex
to the component generated by the same underlying labelled vertex. -/
theorem degreeTwoComponentEquivOfGraphEq_connectedComponentMk
    {k : ℕ} {G E : SimpleGraph (Fin k)} (h : G = E)
    (x : {v : Fin k // G.degree v = 2})
    (y : {v : Fin k // E.degree v = 2})
    (hxy : x.1 = y.1) :
    degreeTwoComponentEquivOfGraphEq h
        ((twoGraph G).connectedComponentMk x) =
      (twoGraph E).connectedComponentMk y := by
  subst E
  have hxy' : x = y := Subtype.ext hxy
  subst y
  rfl

/-- Equality transport carries a direct-edge label to the direct-edge label
with the same underlying unordered edge. -/
theorem kernelEdgeLabelEquivOfGraphEq_inr_eq
    {k : ℕ} {G E : SimpleGraph (Fin k)} (h : G = E)
    (zG : {z : Sym2 (Fin k) // z ∈ directBranchEdges G})
    (zE : {z : Sym2 (Fin k) // z ∈ directBranchEdges E})
    (hz : zG.1 = zE.1) :
    kernelEdgeLabelEquivOfGraphEq h (.inr zG) = .inr zE := by
  subst E
  have hz' : zG = zE := Subtype.ext hz
  subst zE
  rfl

/-- Equality transports of intrinsic suppressed-edge labels compose exactly. -/
theorem kernelEdgeLabelEquivOfGraphEq_trans
    {k : ℕ} {G E F : SimpleGraph (Fin k)}
    (hGE : G = E) (hEF : E = F) (z : KernelEdgeLabel G) :
    kernelEdgeLabelEquivOfGraphEq hEF
        (kernelEdgeLabelEquivOfGraphEq hGE z) =
      kernelEdgeLabelEquivOfGraphEq (hGE.trans hEF) z := by
  subst E
  subst F
  rfl

/-- Two finite indices are heterogeneously equal once their ambient cardinalities
and their numerical values agree. -/
theorem fin_heq_of_card_eq_of_val_eq
    {m n : ℕ} (hmn : m = n) (i : Fin m) (j : Fin n)
    (hij : i.val = j.val) : HEq i j := by
  subst n
  exact heq_of_eq (Fin.ext hij)

private noncomputable def cubicKernelSubdivisionSlotEquivOfProfileEq
    {k ell : ℕ}
    {H : PerronWright.FiniteMultiGraph (2 * ell) (3 * ell)}
    {L M : CubicKernelLengthProfile k ell H}
    (h : L = M) : CubicKernelSubdivisionSlot L ≃ CubicKernelSubdivisionSlot M :=
  Equiv.cast (congrArg CubicKernelSubdivisionSlot h)

private theorem cubicKernelSubdivisionSlotEquivOfProfileEq_inl
    {k ell : ℕ}
    {H : PerronWright.FiniteMultiGraph (2 * ell) (3 * ell)}
    {L M : CubicKernelLengthProfile k ell H}
    (h : L = M) (v : Fin (2 * ell)) :
    cubicKernelSubdivisionSlotEquivOfProfileEq h (.inl v) = .inl v := by
  subst M
  rfl

private theorem cubicKernelSubdivisionSlotEquivOfProfileEq_inr
    {k ell : ℕ}
    {H : PerronWright.FiniteMultiGraph (2 * ell) (3 * ell)}
    {L M : CubicKernelLengthProfile k ell H}
    (h : L = M) (e : Fin (3 * ell)) (i : Fin (L.length e).val) :
    cubicKernelSubdivisionSlotEquivOfProfileEq h (.inr ⟨e, i⟩) =
      .inr ⟨e, cast (congrArg (fun N => Fin (N.length e).val) h) i⟩ := by
  subst M
  rfl

private theorem cubicKernelSubdivisionSlotEquivOfProfileEq_trans_heq
    {k ell : ℕ}
    {H : PerronWright.FiniteMultiGraph (2 * ell) (3 * ell)}
    {L M : CubicKernelLengthProfile k ell H}
    (h : L = M) (f : CubicKernelSubdivisionSlot M ≃ Fin k) :
    HEq ((cubicKernelSubdivisionSlotEquivOfProfileEq h).trans f) f := by
  subst M
  rfl

/-- A positive edge transported by a coordinate relabelling. -/
def CubicKernelSubdivisionDatum.coordinateRelabelPositiveEdge
    {k ell : ℕ}
    {H : PerronWright.FiniteMultiGraph (2 * ell) (3 * ell)}
    (D : CubicKernelSubdivisionDatum k ell H)
    (γ : CubicKernelCoordinatePerm ell)
    (e : {e : Fin (3 * ell) // 0 < (D.profile.length e).val}) :
    {f : Fin (3 * ell) //
      0 < ((D.coordinateRelabel γ).profile.length f).val} :=
  ⟨γ.2 e.1, by simpa using e.2⟩

@[simp]
theorem CubicKernelSubdivisionDatum.coordinateRelabelPositiveEdge_val
    {k ell : ℕ}
    {H : PerronWright.FiniteMultiGraph (2 * ell) (3 * ell)}
    (D : CubicKernelSubdivisionDatum k ell H)
    (γ : CubicKernelCoordinatePerm ell)
    (e : {e : Fin (3 * ell) // 0 < (D.profile.length e).val}) :
    (D.coordinateRelabelPositiveEdge γ e).1 = γ.2 e.1 :=
  rfl

/-- Coordinate relabelling carries the actual degree-two component belonging
to a positive kernel edge to the component belonging to the relabelled edge.
The proof uses an internal path vertex, hence identifies the component itself
rather than only its boundary endpoints. -/
theorem CubicKernelSubdivisionDatum.coordinateRelabel_positiveEdgeComponent
    {k ell : ℕ}
    (K : LabelledConnectedCubicKernel ell)
    (D : CubicKernelSubdivisionDatum k ell K.graph)
    (γ : CubicKernelCoordinatePerm ell)
    (e : {e : Fin (3 * ell) // 0 < (D.profile.length e).val}) :
    degreeTwoComponentEquivOfGraphEq
        (D.coordinateRelabel_reconstructedGraph γ)
        ((D.coordinateRelabel γ).positiveEdgeComponent
          (K.coordinateRelabel γ) (D.coordinateRelabelPositiveEdge γ e)) =
      D.positiveEdgeComponent K e := by
  let D' := D.coordinateRelabel γ
  let K' := K.coordinateRelabel γ
  let e' := D.coordinateRelabelPositiveEdge γ e
  let i : Fin (D.profile.length e.1).val := ⟨0, e.2⟩
  let j : Fin (D'.profile.length e'.1).val :=
    D.profile.coordinatePathIndexEquiv γ e.1 i
  have hcomponent :
      D'.positiveEdgeComponent K' e' =
        (twoGraph D'.reconstructedGraph).connectedComponentMk
          ⟨D'.pathLabel e'.1 j,
            D'.internalVertex_degree_eq_two K' e'.1 j⟩ := by
    apply SimpleGraph.ConnectedComponent.eq.mpr
    exact D'.internalPath_reachable_twoGraph K' e'.1
      ⟨0, e'.2⟩ j
  change degreeTwoComponentEquivOfGraphEq
      (D.coordinateRelabel_reconstructedGraph γ)
      (D'.positiveEdgeComponent K' e') = D.positiveEdgeComponent K e
  rw [hcomponent]
  unfold CubicKernelSubdivisionDatum.positiveEdgeComponent
  apply degreeTwoComponentEquivOfGraphEq_connectedComponentMk
  dsimp only [D', e', j, i,
    CubicKernelSubdivisionDatum.coordinateRelabelPositiveEdge]
  exact D.coordinateRelabel_pathLabel γ e.1 ⟨0, e.2⟩

/-- The positive summand of the intrinsic suppressed-edge label is natural
under coordinate relabelling. -/
theorem CubicKernelSubdivisionDatum.coordinateRelabel_positiveKernelEdgeLabel
    {k ell : ℕ}
    (K : LabelledConnectedCubicKernel ell)
    (D : CubicKernelSubdivisionDatum k ell K.graph)
    (γ : CubicKernelCoordinatePerm ell)
    (e : {e : Fin (3 * ell) // 0 < (D.profile.length e).val}) :
    kernelEdgeLabelEquivOfGraphEq
        (D.coordinateRelabel_reconstructedGraph γ)
        (.inl ((D.coordinateRelabel γ).positiveEdgeComponent
          (K.coordinateRelabel γ) (D.coordinateRelabelPositiveEdge γ e))) =
      (.inl (D.positiveEdgeComponent K e) :
        KernelEdgeLabel D.reconstructedGraph) := by
  let C : (twoGraph (D.coordinateRelabel γ).reconstructedGraph).ConnectedComponent :=
    (D.coordinateRelabel γ).positiveEdgeComponent
      (K.coordinateRelabel γ) (D.coordinateRelabelPositiveEdge γ e)
  change kernelEdgeLabelEquivOfGraphEq
      (D.coordinateRelabel_reconstructedGraph γ)
      (.inl C) =
    (.inl (D.positiveEdgeComponent K e) : KernelEdgeLabel D.reconstructedGraph)
  rw [kernelEdgeLabelEquivOfGraphEq_inl]
  apply congrArg Sum.inl
  simpa only [C] using D.coordinateRelabel_positiveEdgeComponent K γ e

/-- A zero-length edge transported by a coordinate relabelling. -/
def CubicKernelSubdivisionDatum.coordinateRelabelZeroEdge
    {k ell : ℕ}
    {H : PerronWright.FiniteMultiGraph (2 * ell) (3 * ell)}
    (D : CubicKernelSubdivisionDatum k ell H)
    (γ : CubicKernelCoordinatePerm ell)
    (e : {e : Fin (3 * ell) // (D.profile.length e).val = 0}) :
    {f : Fin (3 * ell) //
      ((D.coordinateRelabel γ).profile.length f).val = 0} :=
  ⟨γ.2 e.1, by simpa using e.2⟩

@[simp]
theorem CubicKernelSubdivisionDatum.coordinateRelabelZeroEdge_val
    {k ell : ℕ}
    {H : PerronWright.FiniteMultiGraph (2 * ell) (3 * ell)}
    (D : CubicKernelSubdivisionDatum k ell H)
    (γ : CubicKernelCoordinatePerm ell)
    (e : {e : Fin (3 * ell) // (D.profile.length e).val = 0}) :
    (D.coordinateRelabelZeroEdge γ e).1 = γ.2 e.1 :=
  rfl

/-- For a zero-length edge, the unique edge slot is carried to the unique edge
slot of the relabelled edge. -/
theorem CubicKernelSubdivisionDatum.coordinateRelabel_zeroEdgeSlot
    {k ell : ℕ}
    {H : PerronWright.FiniteMultiGraph (2 * ell) (3 * ell)}
    (D : CubicKernelSubdivisionDatum k ell H)
    (γ : CubicKernelCoordinatePerm ell)
    (e : {e : Fin (3 * ell) // (D.profile.length e).val = 0}) :
    D.coordinateRelabelEdgeSlotEquiv γ
        (⟨e.1, (0 : Fin ((D.profile.length e.1).val + 1))⟩ :
          CubicKernelSubdivisionEdgeSlot D) =
      (⟨γ.2 e.1,
          (0 : Fin (((D.coordinateRelabel γ).profile.length
            (γ.2 e.1)).val + 1))⟩ :
        CubicKernelSubdivisionEdgeSlot (D.coordinateRelabel γ)) := by
  rw [D.coordinateRelabelEdgeSlotEquiv_apply]
  apply Sigma.ext
  · rfl
  · apply heq_of_eq
    apply Fin.ext
    by_cases hfirst :
        γ.1 (cubicKernelOrderedEndpoints H e.1).1 =
          (cubicKernelOrderedEndpoints
            (finiteMultiGraphCoordinateRelabel γ H) (γ.2 e.1)).1
    · exact D.profile.coordinatePathEdgeEquiv_val_of_direct
        γ e.1 hfirst _
    · rw [D.profile.coordinatePathEdgeEquiv_val_of_reversed
        γ e.1 hfirst]
      simp [e.2]

/-- Coordinate relabelling preserves the actual direct branch edge emitted by
a zero-length normalized edge. -/
theorem CubicKernelSubdivisionDatum.coordinateRelabel_zeroLengthEdge_val
    {k ell : ℕ}
    (K : LabelledConnectedCubicKernel ell)
    (D : CubicKernelSubdivisionDatum k ell K.graph)
    (γ : CubicKernelCoordinatePerm ell)
    (e : {e : Fin (3 * ell) // (D.profile.length e).val = 0}) :
    ((D.coordinateRelabel γ).zeroLengthEdgeToDirectBranchEdge
        (K.coordinateRelabel γ) (D.coordinateRelabelZeroEdge γ e)).1 =
      (D.zeroLengthEdgeToDirectBranchEdge K e).1 := by
  let q : CubicKernelSubdivisionEdgeSlot D :=
    ⟨e.1, (0 : Fin ((D.profile.length e.1).val + 1))⟩
  change (D.coordinateRelabel γ).subdivisionEdge
      (⟨γ.2 e.1,
        (0 : Fin (((D.coordinateRelabel γ).profile.length
          (γ.2 e.1)).val + 1))⟩ :
        CubicKernelSubdivisionEdgeSlot (D.coordinateRelabel γ)) =
    D.subdivisionEdge q
  rw [← D.coordinateRelabel_zeroEdgeSlot γ e]
  exact D.coordinateRelabel_subdivisionEdge γ q

/-- The zero-length summand of the intrinsic suppressed-edge label is natural
under coordinate relabelling. -/
theorem CubicKernelSubdivisionDatum.coordinateRelabel_zeroKernelEdgeLabel
    {k ell : ℕ}
    (K : LabelledConnectedCubicKernel ell)
    (D : CubicKernelSubdivisionDatum k ell K.graph)
    (γ : CubicKernelCoordinatePerm ell)
    (e : {e : Fin (3 * ell) // (D.profile.length e).val = 0}) :
    kernelEdgeLabelEquivOfGraphEq
        (D.coordinateRelabel_reconstructedGraph γ)
        (.inr ((D.coordinateRelabel γ).zeroLengthEdgeToDirectBranchEdge
          (K.coordinateRelabel γ) (D.coordinateRelabelZeroEdge γ e))) =
      (.inr (D.zeroLengthEdgeToDirectBranchEdge K e) :
        KernelEdgeLabel D.reconstructedGraph) := by
  apply kernelEdgeLabelEquivOfGraphEq_inr_eq
  exact D.coordinateRelabel_zeroLengthEdge_val K γ e

/-- The full recovered intrinsic edge is natural under coordinate relabelling.
This is proved by the genuine degree-two-component/direct-edge split. -/
theorem CubicKernelSubdivisionDatum.coordinateRelabel_recoveredKernelEdgeEquiv_symm
    {k ell : ℕ}
    (K : LabelledConnectedCubicKernel ell)
    (D : CubicKernelSubdivisionDatum k ell K.graph)
    (γ : CubicKernelCoordinatePerm ell)
    (e : Fin (3 * ell)) :
    kernelEdgeLabelEquivOfGraphEq
        (D.coordinateRelabel_reconstructedGraph γ)
        (((D.coordinateRelabel γ).recoveredKernelEdgeEquiv
          (K.coordinateRelabel γ)).symm (γ.2 e)) =
      (D.recoveredKernelEdgeEquiv K).symm e := by
  by_cases hpos : 0 < (D.profile.length e).val
  · let ep : {f : Fin (3 * ell) // 0 < (D.profile.length f).val} :=
      ⟨e, hpos⟩
    let ep' := D.coordinateRelabelPositiveEdge γ ep
    have hsource :
        (D.recoveredKernelEdgeEquiv K).symm e =
          (.inl (D.positiveEdgeComponent K ep) :
            KernelEdgeLabel D.reconstructedGraph) := by
      apply (D.recoveredKernelEdgeEquiv K).injective
      rw [Equiv.apply_symm_apply]
      exact (D.recoveredKernelEdgeEquiv_positive K ep).symm
    have htarget :
        ((D.coordinateRelabel γ).recoveredKernelEdgeEquiv
          (K.coordinateRelabel γ)).symm (γ.2 e) =
          (.inl ((D.coordinateRelabel γ).positiveEdgeComponent
            (K.coordinateRelabel γ) ep') :
            KernelEdgeLabel (D.coordinateRelabel γ).reconstructedGraph) := by
      apply ((D.coordinateRelabel γ).recoveredKernelEdgeEquiv
        (K.coordinateRelabel γ)).injective
      rw [Equiv.apply_symm_apply]
      exact ((D.coordinateRelabel γ).recoveredKernelEdgeEquiv_positive
        (K.coordinateRelabel γ) ep').symm
    rw [htarget, hsource]
    exact D.coordinateRelabel_positiveKernelEdgeLabel K γ ep
  · have hzero : (D.profile.length e).val = 0 :=
      Nat.eq_zero_of_not_pos hpos
    let ez : {f : Fin (3 * ell) // (D.profile.length f).val = 0} :=
      ⟨e, hzero⟩
    let ez' := D.coordinateRelabelZeroEdge γ ez
    have hsource :
        (D.recoveredKernelEdgeEquiv K).symm e =
          (.inr (D.zeroLengthEdgeToDirectBranchEdge K ez) :
            KernelEdgeLabel D.reconstructedGraph) := by
      apply (D.recoveredKernelEdgeEquiv K).injective
      rw [Equiv.apply_symm_apply]
      exact (D.recoveredKernelEdgeEquiv_zero K ez).symm
    have htarget :
        ((D.coordinateRelabel γ).recoveredKernelEdgeEquiv
          (K.coordinateRelabel γ)).symm (γ.2 e) =
          (.inr ((D.coordinateRelabel γ).zeroLengthEdgeToDirectBranchEdge
            (K.coordinateRelabel γ) ez') :
            KernelEdgeLabel (D.coordinateRelabel γ).reconstructedGraph) := by
      apply ((D.coordinateRelabel γ).recoveredKernelEdgeEquiv
        (K.coordinateRelabel γ)).injective
      rw [Equiv.apply_symm_apply]
      exact ((D.coordinateRelabel γ).recoveredKernelEdgeEquiv_zero
        (K.coordinateRelabel γ) ez').symm
    rw [htarget, hsource]
    exact D.coordinateRelabel_zeroKernelEdgeLabel K γ ez

/-- Casting a datum along equality of its complete connected cubic kernel does
not change the intrinsic recovered edge. -/
theorem cubicKernelSubdivisionDatumCast_recoveredKernelEdgeEquiv_symm
    {k ell : ℕ}
    {K L : LabelledConnectedCubicKernel ell}
    (hK : K = L)
    (D : CubicKernelSubdivisionDatum k ell K.graph)
    (e : Fin (3 * ell)) :
    kernelEdgeLabelEquivOfGraphEq
        (cubicKernelSubdivisionDatumCast_reconstructedGraph
          (congrArg LabelledConnectedCubicKernel.graph hK) D)
        (((cubicKernelSubdivisionDatumCast
          (congrArg LabelledConnectedCubicKernel.graph hK) D).recoveredKernelEdgeEquiv
            L).symm e) =
      (D.recoveredKernelEdgeEquiv K).symm e := by
  subst L
  rfl

namespace CubicKernelPresentation

/-- After global recovered-coordinate relabelling and the dependent kernel
cast, the edge at the transported coordinate still represents the target's
same intrinsic suppressed edge. -/
theorem globalRecoveredAlignedCastDatum_recoveredKernelEdge_intrinsic
    {k ell : ℕ}
    (P Q : CubicKernelPresentation k ell)
    (hG : P.2.reconstructedGraph = Q.2.reconstructedGraph)
    (e : Fin (3 * ell)) :
    kernelEdgeLabelEquivOfGraphEq
        (P.globalRecoveredAlignedCastDatum_graph_eq_target Q hG)
        (((P.globalRecoveredAlignedCastDatum Q hG).recoveredKernelEdgeEquiv
          Q.1).symm
            (P.globalRecoveredKernelEdgeCoordinatePerm Q hG e)) =
      (Q.2.recoveredKernelEdgeEquiv Q.1).symm
        (P.globalRecoveredKernelEdgeCoordinatePerm Q hG e) := by
  let γ := P.globalRecoveredCoordinatePerm Q hG
  let Dγ := P.2.coordinateRelabel γ
  let hK : P.1.coordinateRelabel γ = Q.1 :=
    P.kernel_coordinateRelabel_globalRecoveredCoordinatePerm Q hG
  let hKG : finiteMultiGraphCoordinateRelabel γ P.1.graph = Q.1.graph := by
    change (P.1.coordinateRelabel γ).graph = Q.1.graph
    exact congrArg LabelledConnectedCubicKernel.graph hK
  let D := cubicKernelSubdivisionDatumCast hKG Dγ
  let hCast : D.reconstructedGraph = Dγ.reconstructedGraph :=
    cubicKernelSubdivisionDatumCast_reconstructedGraph hKG Dγ
  let hCoordinate : Dγ.reconstructedGraph = P.2.reconstructedGraph :=
    P.2.coordinateRelabel_reconstructedGraph γ
  let hAll : D.reconstructedGraph = Q.2.reconstructedGraph :=
    hCast.trans (hCoordinate.trans hG)
  let hDQ := P.globalRecoveredAlignedCastDatum_graph_eq_target Q hG
  change kernelEdgeLabelEquivOfGraphEq hDQ
      ((D.recoveredKernelEdgeEquiv Q.1).symm (γ.2 e)) =
    (Q.2.recoveredKernelEdgeEquiv Q.1).symm (γ.2 e)
  let zγ : KernelEdgeLabel Dγ.reconstructedGraph :=
    (Dγ.recoveredKernelEdgeEquiv (P.1.coordinateRelabel γ)).symm (γ.2 e)
  have hcastEdge :
      kernelEdgeLabelEquivOfGraphEq hCast
          ((D.recoveredKernelEdgeEquiv Q.1).symm (γ.2 e)) =
        zγ := by
    exact cubicKernelSubdivisionDatumCast_recoveredKernelEdgeEquiv_symm
      hK Dγ (γ.2 e)
  have hcoordinateEdge :
      kernelEdgeLabelEquivOfGraphEq hCoordinate
          zγ =
        (P.2.recoveredKernelEdgeEquiv P.1).symm e := by
    exact P.2.coordinateRelabel_recoveredKernelEdgeEquiv_symm P.1 γ e
  have hmain :
      kernelEdgeLabelEquivOfGraphEq hAll
          ((D.recoveredKernelEdgeEquiv Q.1).symm (γ.2 e)) =
        (Q.2.recoveredKernelEdgeEquiv Q.1).symm (γ.2 e) := by
    rw [← kernelEdgeLabelEquivOfGraphEq_trans hCast
      (hCoordinate.trans hG)]
    rw [hcastEdge]
    rw [← kernelEdgeLabelEquivOfGraphEq_trans hCoordinate hG]
    rw [hcoordinateEdge]
    exact P.globalRecoveredKernelEdgeCoordinatePerm_intrinsic Q hG e
  exact hmain

/-- The fixed-kernel recovered edge permutation from the globally aligned cast
datum to the target datum is the identity. -/
theorem globalRecoveredAlignedCastDatum_recoveredKernelEdgeCoordinatePerm
    {k ell : ℕ}
    (P Q : CubicKernelPresentation k ell)
    (hG : P.2.reconstructedGraph = Q.2.reconstructedGraph) :
    (P.globalRecoveredAlignedCastDatum Q hG).recoveredKernelEdgeCoordinatePerm Q.1 Q.2
          (P.globalRecoveredAlignedCastDatum_graph_eq_target Q hG) =
      Equiv.refl (Fin (3 * ell)) := by
  apply Equiv.ext
  intro f
  let γ := P.globalRecoveredKernelEdgeCoordinatePerm Q hG
  obtain ⟨e, rfl⟩ := γ.surjective f
  let D := P.globalRecoveredAlignedCastDatum Q hG
  let hDQ := P.globalRecoveredAlignedCastDatum_graph_eq_target Q hG
  have hintrinsic :=
    D.recoveredKernelEdgeCoordinatePerm_intrinsic Q.1 Q.2 hDQ (γ e)
  have hsame :=
    P.globalRecoveredAlignedCastDatum_recoveredKernelEdge_intrinsic Q hG e
  rw [hsame] at hintrinsic
  exact ((Q.2.recoveredKernelEdgeEquiv Q.1).symm.injective
    hintrinsic).symm

/-- Once branch and edge coordinates are both the identity, the recovered
internal path transport preserves the numerical path index. -/
theorem globalRecoveredAlignedCastDatum_recoveredPathIndexEquiv_val
    {k ell : ℕ}
    (P Q : CubicKernelPresentation k ell)
    (hG : P.2.reconstructedGraph = Q.2.reconstructedGraph)
    (e : Fin (3 * ell))
    (i : Fin ((P.globalRecoveredAlignedCastDatum Q hG).profile.length e).val) :
    (((P.globalRecoveredAlignedCastDatum Q hG).recoveredPathIndexEquiv
      Q.1 Q.2 (P.globalRecoveredAlignedCastDatum_graph_eq_target Q hG) e) i).val
      = i.val := by
  let D := P.globalRecoveredAlignedCastDatum Q hG
  let hDQ := P.globalRecoveredAlignedCastDatum_graph_eq_target Q hG
  have hedge :=
    P.globalRecoveredAlignedCastDatum_recoveredKernelEdgeCoordinatePerm Q hG
  have hbranch :=
    P.globalRecoveredAlignedCastDatum_recoveredBranchCoordinatePerm Q hG
  by_cases hloop : (Q.1.graph.endpoints e).IsDiag
  · rw [D.recoveredPathIndexEquiv_of_loop Q.1 Q.2 hDQ e hloop]
    simp only [finCongr_apply_coe]
  · have hfirst :
        D.recoveredBranchCoordinatePerm Q.1 Q.2 hDQ
            (cubicKernelOrderedEndpoints Q.1.graph e).1 =
          (cubicKernelOrderedEndpoints Q.1.graph
            (D.recoveredKernelEdgeCoordinatePerm Q.1 Q.2 hDQ e)).1 := by
      rw [hbranch, hedge]
      rfl
    rw [D.recoveredPathIndexEquiv_of_nonloop_direct
      Q.1 Q.2 hDQ e hloop hfirst]
    simp only [finCongr_apply_coe]

/-- The same path-index statement in the dependent form needed to compare
sigma slots.  The codomain size is supplied by the intrinsic recovered-edge
length theorem, not by an illicit definitional identification. -/
theorem globalRecoveredAlignedCastDatum_recoveredPathIndexEquiv_heq
    {k ell : ℕ}
    (P Q : CubicKernelPresentation k ell)
    (hG : P.2.reconstructedGraph = Q.2.reconstructedGraph)
    (e : Fin (3 * ell))
    (i : Fin ((P.globalRecoveredAlignedCastDatum Q hG).profile.length e).val) :
    HEq
      (((P.globalRecoveredAlignedCastDatum Q hG).recoveredPathIndexEquiv
        Q.1 Q.2 (P.globalRecoveredAlignedCastDatum_graph_eq_target Q hG) e) i)
      i := by
  let D := P.globalRecoveredAlignedCastDatum Q hG
  let hDQ := P.globalRecoveredAlignedCastDatum_graph_eq_target Q hG
  apply fin_heq_of_card_eq_of_val_eq
    (D.profile_length_recoveredKernelEdgeCoordinatePerm Q.1 Q.2 hDQ e).symm
  exact P.globalRecoveredAlignedCastDatum_recoveredPathIndexEquiv_val Q hG e i

/-- Expressing the target datum in the recovered coordinates of the globally
aligned cast datum changes nothing: all branch, edge, and forced non-loop path
coordinates are already aligned. -/
theorem globalRecoveredAlignedCastDatum_recoveredCoordinateAlignedDatum
    {k ell : ℕ}
    (P Q : CubicKernelPresentation k ell)
    (hG : P.2.reconstructedGraph = Q.2.reconstructedGraph) :
    (P.globalRecoveredAlignedCastDatum Q hG).recoveredCoordinateAlignedDatum Q.1 Q.2
          (P.globalRecoveredAlignedCastDatum_graph_eq_target Q hG) = Q.2 := by
  rcases Q with ⟨QK, ⟨qprofile, qlabels⟩⟩
  let Q : CubicKernelPresentation k ell :=
    ⟨QK, ⟨qprofile, qlabels⟩⟩
  let D := P.globalRecoveredAlignedCastDatum Q hG
  let hDQ := P.globalRecoveredAlignedCastDatum_graph_eq_target Q hG
  have hprofile := P.globalRecoveredAlignedCastDatum_profile Q hG
  have hedge :=
    P.globalRecoveredAlignedCastDatum_recoveredKernelEdgeCoordinatePerm Q hG
  change D.profile = qprofile at hprofile
  change
    (⟨D.profile, D.recoveredCoordinateAlignedLabels Q.1 Q.2 hDQ⟩ :
      CubicKernelSubdivisionDatum k ell Q.1.graph) =
      ⟨qprofile, qlabels⟩
  congr 1
  have hlabels :
      D.recoveredCoordinateAlignedLabels Q.1 Q.2 hDQ =
        (cubicKernelSubdivisionSlotEquivOfProfileEq hprofile).trans qlabels := by
    apply Equiv.ext
    intro z
    change D.recoveredCoordinateAlignedLabels Q.1 Q.2 hDQ z =
      qlabels (cubicKernelSubdivisionSlotEquivOfProfileEq hprofile z)
    cases z with
    | inl v =>
        rw [cubicKernelSubdivisionSlotEquivOfProfileEq_inl]
        change D.recoveredCoordinateAlignedLabels Q.1 Q.2 hDQ (.inl v) =
          qlabels (.inl v)
        rw [D.recoveredCoordinateAlignedLabels_branch]
        have hv := P.globalRecoveredAlignedCastDatum_branchLabel Q hG v
        simpa only [Q, CubicKernelSubdivisionDatum.branchLabel] using hv
    | inr s =>
        rcases s with ⟨e, i⟩
        rw [cubicKernelSubdivisionSlotEquivOfProfileEq_inr]
        rw [D.recoveredCoordinateAlignedLabels_path]
        let s₁ : CubicKernelSubdivisionSlot qprofile :=
          .inr ⟨D.recoveredKernelEdgeCoordinatePerm Q.1 Q.2 hDQ e,
            D.recoveredPathIndexEquiv Q.1 Q.2 hDQ e i⟩
        let s₂ : CubicKernelSubdivisionSlot qprofile :=
          .inr ⟨e,
            cast (congrArg (fun N => Fin (N.length e).val) hprofile) i⟩
        change qlabels s₁ = qlabels s₂
        apply congrArg qlabels
        dsimp only [s₁, s₂]
        apply congrArg Sum.inr
        apply Sigma.ext
        · have hedgeAt := congrArg (fun σ => σ e) hedge
          simpa only [Equiv.refl_apply] using hedgeAt
        ·
          have hindex :=
            P.globalRecoveredAlignedCastDatum_recoveredPathIndexEquiv_heq
              Q hG e i
          have hcast :=
            eqRec_heq
              (φ := fun T : Type => T)
              (congrArg (fun N => Fin (N.length e).val) hprofile) i
          exact hindex.trans hcast.symm
  exact (heq_of_eq hlabels).trans
    (cubicKernelSubdivisionSlotEquivOfProfileEq_trans_heq hprofile qlabels)

/-- The target presentation differs from the globally coordinate-aligned
source by one unique set of loop reversals. -/
theorem existsUnique_reverseLoops_globalRecoveredAlignedCastDatum_eq_target
    {k ell : ℕ}
    (P Q : CubicKernelPresentation k ell)
    (hG : P.2.reconstructedGraph = Q.2.reconstructedGraph) :
    ∃! A : Finset (CubicKernelLoopEdge Q.1.graph),
      (P.globalRecoveredAlignedCastDatum Q hG).reverseLoops A = Q.2 := by
  let D := P.globalRecoveredAlignedCastDatum Q hG
  let hDQ := P.globalRecoveredAlignedCastDatum_graph_eq_target Q hG
  have haligned :=
    P.globalRecoveredAlignedCastDatum_recoveredCoordinateAlignedDatum Q hG
  obtain ⟨A, hA, hunique⟩ :=
    D.existsUnique_reverseLoops_eq_alignedDatum Q.1 Q.2 hDQ
  refine ⟨A, hA.trans haligned, ?_⟩
  intro B hB
  apply hunique B
  exact hB.trans haligned.symm

end CubicKernelPresentation

