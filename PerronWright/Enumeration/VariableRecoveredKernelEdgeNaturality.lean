import PerronWright.Enumeration.VariableKernelSubdivisionDatumRelabelNaturality

/-!
# Naturality of recovered variable-kernel edge coordinates

The intrinsic suppressed-edge label of a bounded-kernel subdivision is
natural under simultaneous branch/edge coordinate relabelling.  Positive
length edges are compared through their actual connected components in the
degree-two graph; zero-length edges are compared through their actual direct
branch edges.  The same statement is then transported through the dependent
kernel cast used by the global presentation decoder.

Unlike the cubic case, the displayed edge-coordinate cardinality is part of
the bounded-kernel index.  Consequently the cast lemma below records the
induced `Fin.cast` explicitly.  This keeps the final fixed-kernel recovered
edge permutation theorem independent of definitional coincidences between
the source and target shape indices.
-/

noncomputable section

namespace PerronWright.GraphCore

open scoped Classical

/-- Equality of ambient labelled graphs transports connected components of
their induced degree-two graphs. -/
noncomputable def variableDegreeTwoComponentEquivOfGraphEq
    {k : ℕ} {G H : SimpleGraph (Fin k)} (h : G = H) :
    (twoGraph G).ConnectedComponent ≃
      (twoGraph H).ConnectedComponent := by
  subst H
  exact Equiv.refl _

@[simp] theorem variableKernelEdgeLabelEquivOfGraphEq_inl
    {k : ℕ} {G H : SimpleGraph (Fin k)} (h : G = H)
    (C : (twoGraph G).ConnectedComponent) :
    variableKernelEdgeLabelEquivOfGraphEq h (.inl C) =
      .inl (variableDegreeTwoComponentEquivOfGraphEq h C) := by
  subst H
  rfl

/-- Equality transport carries a component generated by a degree-two vertex
to the component generated by the same underlying labelled vertex. -/
theorem variableDegreeTwoComponentEquivOfGraphEq_connectedComponentMk
    {k : ℕ} {G H : SimpleGraph (Fin k)} (h : G = H)
    (x : {v : Fin k // G.degree v = 2})
    (y : {v : Fin k // H.degree v = 2})
    (hxy : x.1 = y.1) :
    variableDegreeTwoComponentEquivOfGraphEq h
        ((twoGraph G).connectedComponentMk x) =
      (twoGraph H).connectedComponentMk y := by
  subst H
  have hxy' : x = y := Subtype.ext hxy
  subst y
  rfl

/-- Equality transport carries a direct-edge label to the direct-edge label
with the same underlying unordered edge. -/
theorem variableKernelEdgeLabelEquivOfGraphEq_inr_eq
    {k : ℕ} {G H : SimpleGraph (Fin k)} (h : G = H)
    (zG : {z : Sym2 (Fin k) // z ∈ directBranchEdges G})
    (zH : {z : Sym2 (Fin k) // z ∈ directBranchEdges H})
    (hz : zG.1 = zH.1) :
    variableKernelEdgeLabelEquivOfGraphEq h (.inr zG) = .inr zH := by
  subst H
  have hz' : zG = zH := Subtype.ext hz
  subst zH
  rfl

/-- Finite indices are heterogeneously equal when their cardinalities and
their numerical values agree. -/
theorem variableFin_heq_of_card_eq_of_val_eq
    {m n : ℕ} (hmn : m = n) (i : Fin m) (j : Fin n)
    (hij : i.val = j.val) : HEq i j := by
  subst n
  exact heq_of_eq (Fin.ext hij)

/-- A positive edge transported by a bounded-kernel coordinate relabelling. -/
def BoundedKernelSubdivisionDatum.coordinateRelabelPositiveEdge
    {k ell : ℕ} {K : LabelledBoundedKernel ell}
    (D : BoundedKernelSubdivisionDatum k K)
    (gamma : BoundedKernelCoordinatePerm K)
    (e : {e : Fin K.shape.2.1.val // 0 < (D.profile.length e).val}) :
    {f : Fin (K.coordinateRelabel gamma).shape.2.1.val //
      0 < ((D.coordinateRelabel gamma).profile.length f).val} :=
  ⟨gamma.2 e.1, by simpa using e.2⟩

@[simp] theorem BoundedKernelSubdivisionDatum.coordinateRelabelPositiveEdge_val
    {k ell : ℕ} {K : LabelledBoundedKernel ell}
    (D : BoundedKernelSubdivisionDatum k K)
    (gamma : BoundedKernelCoordinatePerm K)
    (e : {e : Fin K.shape.2.1.val // 0 < (D.profile.length e).val}) :
    (D.coordinateRelabelPositiveEdge gamma e).1 = gamma.2 e.1 :=
  rfl

/-- Coordinate relabelling carries the actual degree-two component belonging
to a positive bounded-kernel edge to the component belonging to the
relabelled edge. -/
theorem BoundedKernelSubdivisionDatum.coordinateRelabel_positiveEdgeComponent
    {k ell : ℕ}
    (K : LabelledBoundedKernel ell)
    (D : BoundedKernelSubdivisionDatum k K)
    (gamma : BoundedKernelCoordinatePerm K)
    (e : {e : Fin K.shape.2.1.val // 0 < (D.profile.length e).val}) :
    variableDegreeTwoComponentEquivOfGraphEq
        (D.coordinateRelabel_reconstructedGraph gamma)
        ((D.coordinateRelabel gamma).positiveEdgeComponent
          (K.coordinateRelabel gamma)
          (D.coordinateRelabelPositiveEdge gamma e)) =
      D.positiveEdgeComponent K e := by
  let D' := D.coordinateRelabel gamma
  let K' := K.coordinateRelabel gamma
  let e' := D.coordinateRelabelPositiveEdge gamma e
  let i : Fin (D.profile.length e.1).val := ⟨0, e.2⟩
  let j : Fin (D'.profile.length e'.1).val :=
    D.profile.coordinatePathIndexEquiv gamma e.1 i
  have hcomponent :
      D'.positiveEdgeComponent K' e' =
        (twoGraph D'.reconstructedGraph).connectedComponentMk
          ⟨D'.pathLabel e'.1 j,
            D'.internalVertex_degree_eq_two e'.1 j⟩ := by
    apply SimpleGraph.ConnectedComponent.eq.mpr
    exact D'.internalPath_reachable_twoGraph K' e'.1
      ⟨0, e'.2⟩ j
  change variableDegreeTwoComponentEquivOfGraphEq
      (D.coordinateRelabel_reconstructedGraph gamma)
      (D'.positiveEdgeComponent K' e') = D.positiveEdgeComponent K e
  rw [hcomponent]
  unfold BoundedKernelSubdivisionDatum.positiveEdgeComponent
  apply variableDegreeTwoComponentEquivOfGraphEq_connectedComponentMk
  dsimp only [D', e', j, i,
    BoundedKernelSubdivisionDatum.coordinateRelabelPositiveEdge]
  exact D.coordinateRelabel_pathLabel gamma e.1 ⟨0, e.2⟩

/-- The positive summand of the intrinsic suppressed-edge label is natural
under coordinate relabelling. -/
theorem BoundedKernelSubdivisionDatum.coordinateRelabel_positiveKernelEdgeLabel
    {k ell : ℕ}
    (K : LabelledBoundedKernel ell)
    (D : BoundedKernelSubdivisionDatum k K)
    (gamma : BoundedKernelCoordinatePerm K)
    (e : {e : Fin K.shape.2.1.val // 0 < (D.profile.length e).val}) :
    variableKernelEdgeLabelEquivOfGraphEq
        (D.coordinateRelabel_reconstructedGraph gamma)
        (.inl ((D.coordinateRelabel gamma).positiveEdgeComponent
          (K.coordinateRelabel gamma)
          (D.coordinateRelabelPositiveEdge gamma e))) =
      (.inl (D.positiveEdgeComponent K e) :
        KernelEdgeLabel D.reconstructedGraph) := by
  let C : (twoGraph (D.coordinateRelabel gamma).reconstructedGraph).ConnectedComponent :=
    (D.coordinateRelabel gamma).positiveEdgeComponent
      (K.coordinateRelabel gamma)
      (D.coordinateRelabelPositiveEdge gamma e)
  change variableKernelEdgeLabelEquivOfGraphEq
      (D.coordinateRelabel_reconstructedGraph gamma) (.inl C) =
    (.inl (D.positiveEdgeComponent K e) :
      KernelEdgeLabel D.reconstructedGraph)
  rw [variableKernelEdgeLabelEquivOfGraphEq_inl]
  apply congrArg Sum.inl
  simpa only [C] using
    D.coordinateRelabel_positiveEdgeComponent K gamma e

/-- A zero-length edge transported by a bounded-kernel coordinate
relabelling. -/
def BoundedKernelSubdivisionDatum.coordinateRelabelZeroEdge
    {k ell : ℕ} {K : LabelledBoundedKernel ell}
    (D : BoundedKernelSubdivisionDatum k K)
    (gamma : BoundedKernelCoordinatePerm K)
    (e : {e : Fin K.shape.2.1.val // (D.profile.length e).val = 0}) :
    {f : Fin (K.coordinateRelabel gamma).shape.2.1.val //
      ((D.coordinateRelabel gamma).profile.length f).val = 0} :=
  ⟨gamma.2 e.1, by simpa using e.2⟩

@[simp] theorem BoundedKernelSubdivisionDatum.coordinateRelabelZeroEdge_val
    {k ell : ℕ} {K : LabelledBoundedKernel ell}
    (D : BoundedKernelSubdivisionDatum k K)
    (gamma : BoundedKernelCoordinatePerm K)
    (e : {e : Fin K.shape.2.1.val // (D.profile.length e).val = 0}) :
    (D.coordinateRelabelZeroEdge gamma e).1 = gamma.2 e.1 :=
  rfl

/-- For a zero-length edge, the unique edge slot is carried to the unique
edge slot of the relabelled edge. -/
theorem BoundedKernelSubdivisionDatum.coordinateRelabel_zeroEdgeSlot
    {k ell : ℕ} {K : LabelledBoundedKernel ell}
    (D : BoundedKernelSubdivisionDatum k K)
    (gamma : BoundedKernelCoordinatePerm K)
    (e : {e : Fin K.shape.2.1.val // (D.profile.length e).val = 0}) :
    D.coordinateRelabelEdgeSlotEquiv gamma
        (⟨e.1, (0 : Fin ((D.profile.length e.1).val + 1))⟩ :
          BoundedKernelSubdivisionEdgeSlot D) =
      (⟨gamma.2 e.1,
          (0 : Fin (((D.coordinateRelabel gamma).profile.length
            (gamma.2 e.1)).val + 1))⟩ :
        BoundedKernelSubdivisionEdgeSlot (D.coordinateRelabel gamma)) := by
  rw [D.coordinateRelabelEdgeSlotEquiv_apply]
  apply Sigma.ext
  · rfl
  · apply heq_of_eq
    apply Fin.ext
    by_cases hfirst :
        gamma.1 (boundedKernelOrderedEndpoints K.shape e.1).1 =
          (boundedKernelOrderedEndpoints
            (K.coordinateRelabel gamma).shape (gamma.2 e.1)).1
    · exact D.profile.coordinatePathEdgeEquiv_val_of_direct
        gamma e.1 hfirst _
    · rw [D.profile.coordinatePathEdgeEquiv_val_of_reversed
        gamma e.1 hfirst]
      simp [e.2]

/-- Coordinate relabelling preserves the actual direct branch edge emitted
by a zero-length bounded-kernel edge. -/
theorem BoundedKernelSubdivisionDatum.coordinateRelabel_zeroLengthEdge_val
    {k ell : ℕ}
    (K : LabelledBoundedKernel ell)
    (D : BoundedKernelSubdivisionDatum k K)
    (gamma : BoundedKernelCoordinatePerm K)
    (e : {e : Fin K.shape.2.1.val // (D.profile.length e).val = 0}) :
    ((D.coordinateRelabel gamma).zeroLengthEdgeToDirectBranchEdge
        (K.coordinateRelabel gamma)
        (D.coordinateRelabelZeroEdge gamma e)).1 =
      (D.zeroLengthEdgeToDirectBranchEdge K e).1 := by
  let q : BoundedKernelSubdivisionEdgeSlot D :=
    ⟨e.1, (0 : Fin ((D.profile.length e.1).val + 1))⟩
  change (D.coordinateRelabel gamma).subdivisionEdge
      (⟨gamma.2 e.1,
        (0 : Fin (((D.coordinateRelabel gamma).profile.length
          (gamma.2 e.1)).val + 1))⟩ :
        BoundedKernelSubdivisionEdgeSlot (D.coordinateRelabel gamma)) =
    D.subdivisionEdge q
  rw [← D.coordinateRelabel_zeroEdgeSlot gamma e]
  exact D.coordinateRelabel_subdivisionEdge gamma q

/-- The zero-length summand of the intrinsic suppressed-edge label is
natural under coordinate relabelling. -/
theorem BoundedKernelSubdivisionDatum.coordinateRelabel_zeroKernelEdgeLabel
    {k ell : ℕ}
    (K : LabelledBoundedKernel ell)
    (D : BoundedKernelSubdivisionDatum k K)
    (gamma : BoundedKernelCoordinatePerm K)
    (e : {e : Fin K.shape.2.1.val // (D.profile.length e).val = 0}) :
    variableKernelEdgeLabelEquivOfGraphEq
        (D.coordinateRelabel_reconstructedGraph gamma)
        (.inr ((D.coordinateRelabel gamma).zeroLengthEdgeToDirectBranchEdge
          (K.coordinateRelabel gamma)
          (D.coordinateRelabelZeroEdge gamma e))) =
      (.inr (D.zeroLengthEdgeToDirectBranchEdge K e) :
        KernelEdgeLabel D.reconstructedGraph) := by
  apply variableKernelEdgeLabelEquivOfGraphEq_inr_eq
  exact D.coordinateRelabel_zeroLengthEdge_val K gamma e

/-- The full recovered intrinsic edge is natural under coordinate
relabelling.  The proof uses the genuine degree-two-component/direct-edge
split, and hence retains parallel suppressed edges. -/
theorem BoundedKernelSubdivisionDatum.coordinateRelabel_recoveredKernelEdgeEquiv_symm
    {k ell : ℕ}
    (K : LabelledBoundedKernel ell)
    (D : BoundedKernelSubdivisionDatum k K)
    (gamma : BoundedKernelCoordinatePerm K)
    (e : Fin K.shape.2.1.val) :
    variableKernelEdgeLabelEquivOfGraphEq
        (D.coordinateRelabel_reconstructedGraph gamma)
        (((D.coordinateRelabel gamma).recoveredKernelEdgeEquiv
          (K.coordinateRelabel gamma)).symm (gamma.2 e)) =
      (D.recoveredKernelEdgeEquiv K).symm e := by
  let e' : Fin (K.coordinateRelabel gamma).shape.2.1.val := gamma.2 e
  change variableKernelEdgeLabelEquivOfGraphEq
      (D.coordinateRelabel_reconstructedGraph gamma)
      (((D.coordinateRelabel gamma).recoveredKernelEdgeEquiv
        (K.coordinateRelabel gamma)).symm e') =
    (D.recoveredKernelEdgeEquiv K).symm e
  by_cases hpos : 0 < (D.profile.length e).val
  · let ep : {f : Fin K.shape.2.1.val //
        0 < (D.profile.length f).val} := ⟨e, hpos⟩
    let ep' := D.coordinateRelabelPositiveEdge gamma ep
    have hsource :
        (D.recoveredKernelEdgeEquiv K).symm e =
          (.inl (D.positiveEdgeComponent K ep) :
            KernelEdgeLabel D.reconstructedGraph) := by
      apply (D.recoveredKernelEdgeEquiv K).injective
      rw [Equiv.apply_symm_apply]
      exact (D.recoveredKernelEdgeEquiv_positive K ep).symm
    have htarget :
        ((D.coordinateRelabel gamma).recoveredKernelEdgeEquiv
          (K.coordinateRelabel gamma)).symm e' =
          (.inl ((D.coordinateRelabel gamma).positiveEdgeComponent
            (K.coordinateRelabel gamma) ep') :
            KernelEdgeLabel (D.coordinateRelabel gamma).reconstructedGraph) := by
      apply ((D.coordinateRelabel gamma).recoveredKernelEdgeEquiv
        (K.coordinateRelabel gamma)).injective
      rw [Equiv.apply_symm_apply]
      exact ((D.coordinateRelabel gamma).recoveredKernelEdgeEquiv_positive
        (K.coordinateRelabel gamma) ep').symm
    rw [htarget, hsource]
    exact D.coordinateRelabel_positiveKernelEdgeLabel K gamma ep
  · have hzero : (D.profile.length e).val = 0 :=
      Nat.eq_zero_of_not_pos hpos
    let ez : {f : Fin K.shape.2.1.val //
        (D.profile.length f).val = 0} := ⟨e, hzero⟩
    let ez' := D.coordinateRelabelZeroEdge gamma ez
    have hsource :
        (D.recoveredKernelEdgeEquiv K).symm e =
          (.inr (D.zeroLengthEdgeToDirectBranchEdge K ez) :
            KernelEdgeLabel D.reconstructedGraph) := by
      apply (D.recoveredKernelEdgeEquiv K).injective
      rw [Equiv.apply_symm_apply]
      exact (D.recoveredKernelEdgeEquiv_zero K ez).symm
    have htarget :
        ((D.coordinateRelabel gamma).recoveredKernelEdgeEquiv
          (K.coordinateRelabel gamma)).symm e' =
          (.inr ((D.coordinateRelabel gamma).zeroLengthEdgeToDirectBranchEdge
            (K.coordinateRelabel gamma) ez') :
            KernelEdgeLabel (D.coordinateRelabel gamma).reconstructedGraph) := by
      apply ((D.coordinateRelabel gamma).recoveredKernelEdgeEquiv
        (K.coordinateRelabel gamma)).injective
      rw [Equiv.apply_symm_apply]
      exact ((D.coordinateRelabel gamma).recoveredKernelEdgeEquiv_zero
        (K.coordinateRelabel gamma) ez').symm
    rw [htarget, hsource]
    exact D.coordinateRelabel_zeroKernelEdgeLabel K gamma ez

/-- Casting a datum along equality of its bounded-kernel index does not
change the intrinsic recovered edge.  The edge coordinate is transported by
the induced equality of displayed edge counts. -/
theorem boundedKernelSubdivisionDatumCast_recoveredKernelEdgeEquiv_symm
    {k ell : ℕ} {K L : LabelledBoundedKernel ell}
    (hK : K = L)
    (D : BoundedKernelSubdivisionDatum k K)
    (e : Fin K.shape.2.1.val) :
    variableKernelEdgeLabelEquivOfGraphEq
        (boundedKernelSubdivisionDatumCast_reconstructedGraph hK D)
        (((boundedKernelSubdivisionDatumCast hK D).recoveredKernelEdgeEquiv
          L).symm
            (Fin.cast
              (congrArg (fun J : LabelledBoundedKernel ell ↦
                J.shape.2.1.val) hK) e)) =
      (D.recoveredKernelEdgeEquiv K).symm e := by
  subst L
  rfl

/-- The fixed-kernel recovered edge-coordinate permutation between two
subdivision data over the same bounded kernel. -/
noncomputable def BoundedKernelSubdivisionDatum.recoveredKernelEdgeCoordinatePerm
    {k ell : ℕ}
    (K : LabelledBoundedKernel ell)
    (D E : BoundedKernelSubdivisionDatum k K)
    (hG : D.reconstructedGraph = E.reconstructedGraph) :
    Equiv.Perm (Fin K.shape.2.1.val) :=
  ((D.recoveredKernelEdgeEquiv K).symm.trans
      (variableKernelEdgeLabelEquivOfGraphEq hG)).trans
    (E.recoveredKernelEdgeEquiv K)

/-- The intrinsic edge represented by a `D`-coordinate is transported to
the intrinsic edge represented by the corresponding recovered
`E`-coordinate. -/
theorem BoundedKernelSubdivisionDatum.recoveredKernelEdgeCoordinatePerm_intrinsic
    {k ell : ℕ}
    (K : LabelledBoundedKernel ell)
    (D E : BoundedKernelSubdivisionDatum k K)
    (hG : D.reconstructedGraph = E.reconstructedGraph)
    (e : Fin K.shape.2.1.val) :
    variableKernelEdgeLabelEquivOfGraphEq hG
        ((D.recoveredKernelEdgeEquiv K).symm e) =
      (E.recoveredKernelEdgeEquiv K).symm
        (D.recoveredKernelEdgeCoordinatePerm K E hG e) := by
  apply (E.recoveredKernelEdgeEquiv K).injective
  simp only [BoundedKernelSubdivisionDatum.recoveredKernelEdgeCoordinatePerm,
    Equiv.trans_apply, Equiv.apply_symm_apply]

namespace BoundedKernelPresentation

/-- The edge-count cast induced by the exact globally aligned kernel equality
is the same numerical transport as the recovered cross-presentation edge
equivalence. -/
theorem globalRecoveredAlignedCastDatum_edgeCoordinate_cast
    {k ell : ℕ} (hell : 0 < ell)
    (P Q : BoundedKernelPresentation k ell)
    (hG : P.2.reconstructedGraph = Q.2.reconstructedGraph)
    (e : Fin P.1.toLabelledBoundedKernel.shape.2.1.val) :
    let gamma := P.globalRecoveredCoordinatePerm Q hG
    let hK :
        P.1.toLabelledBoundedKernel.coordinateRelabel gamma =
          Q.1.toLabelledBoundedKernel :=
      congrArg LabelledConnectedBoundedKernel.toLabelledBoundedKernel
        (P.kernel_coordinateRelabel_globalRecoveredCoordinatePerm
          hell Q hG)
    Fin.cast
        (congrArg (fun J : LabelledBoundedKernel ell ↦
          J.shape.2.1.val) hK)
        (gamma.2 e) =
      P.globalRecoveredKernelEdgeCoordinateEquiv Q hG e := by
  dsimp only
  rw [← P.kernelEdgeCoordinateCountCast_globalRecoveredKernelEdgeCoordinatePerm
    Q hG e]
  apply Fin.ext
  change
    (Fin.cast _
      (P.globalRecoveredKernelEdgeCoordinatePerm Q hG e)).val =
      (P.globalRecoveredKernelEdgeCoordinatePerm Q hG e).val
  exact Fin.val_cast _ _

/-- After global coordinate relabelling and the dependent bounded-kernel
cast, the transported edge coordinate still denotes the target's same
intrinsic suppressed edge. -/
theorem globalRecoveredAlignedCastDatum_recoveredKernelEdge_intrinsic
    {k ell : ℕ} (hell : 0 < ell)
    (P Q : BoundedKernelPresentation k ell)
    (hG : P.2.reconstructedGraph = Q.2.reconstructedGraph)
    (e : Fin P.1.toLabelledBoundedKernel.shape.2.1.val) :
    variableKernelEdgeLabelEquivOfGraphEq
        (P.globalRecoveredAlignedCastDatum_graph_eq_target hell Q hG)
        (((P.globalRecoveredAlignedCastDatum hell Q hG).recoveredKernelEdgeEquiv
          Q.1.toLabelledBoundedKernel).symm
            (P.globalRecoveredKernelEdgeCoordinateEquiv Q hG e)) =
      (Q.2.recoveredKernelEdgeEquiv
        Q.1.toLabelledBoundedKernel).symm
          (P.globalRecoveredKernelEdgeCoordinateEquiv Q hG e) := by
  let gamma := P.globalRecoveredCoordinatePerm Q hG
  let KP := P.1.toLabelledBoundedKernel
  let KQ := Q.1.toLabelledBoundedKernel
  let Dgamma := P.2.coordinateRelabel gamma
  let hConnected : P.1.coordinateRelabel gamma = Q.1 :=
    P.kernel_coordinateRelabel_globalRecoveredCoordinatePerm hell Q hG
  let hK : KP.coordinateRelabel gamma = KQ :=
    congrArg LabelledConnectedBoundedKernel.toLabelledBoundedKernel hConnected
  let D := boundedKernelSubdivisionDatumCast hK Dgamma
  let hCast : D.reconstructedGraph = Dgamma.reconstructedGraph :=
    boundedKernelSubdivisionDatumCast_reconstructedGraph hK Dgamma
  let hCoordinate : Dgamma.reconstructedGraph = P.2.reconstructedGraph :=
    P.2.coordinateRelabel_reconstructedGraph gamma
  let hAll : D.reconstructedGraph = Q.2.reconstructedGraph :=
    hCast.trans (hCoordinate.trans hG)
  let hDQ :=
    P.globalRecoveredAlignedCastDatum_graph_eq_target hell Q hG
  change variableKernelEdgeLabelEquivOfGraphEq hDQ
      ((D.recoveredKernelEdgeEquiv KQ).symm
        (P.globalRecoveredKernelEdgeCoordinateEquiv Q hG e)) =
    (Q.2.recoveredKernelEdgeEquiv KQ).symm
      (P.globalRecoveredKernelEdgeCoordinateEquiv Q hG e)
  let zgamma : KernelEdgeLabel Dgamma.reconstructedGraph :=
    (Dgamma.recoveredKernelEdgeEquiv (KP.coordinateRelabel gamma)).symm
      (gamma.2 e)
  have hcastEdge :
      variableKernelEdgeLabelEquivOfGraphEq hCast
          ((D.recoveredKernelEdgeEquiv KQ).symm
            (P.globalRecoveredKernelEdgeCoordinateEquiv Q hG e)) =
        zgamma := by
    rw [← P.globalRecoveredAlignedCastDatum_edgeCoordinate_cast hell Q hG e]
    exact boundedKernelSubdivisionDatumCast_recoveredKernelEdgeEquiv_symm
      hK Dgamma (gamma.2 e)
  have hcoordinateEdge :
      variableKernelEdgeLabelEquivOfGraphEq hCoordinate zgamma =
        (P.2.recoveredKernelEdgeEquiv KP).symm e := by
    exact P.2.coordinateRelabel_recoveredKernelEdgeEquiv_symm
      KP gamma e
  have hmain :
      variableKernelEdgeLabelEquivOfGraphEq hAll
          ((D.recoveredKernelEdgeEquiv KQ).symm
            (P.globalRecoveredKernelEdgeCoordinateEquiv Q hG e)) =
        (Q.2.recoveredKernelEdgeEquiv KQ).symm
          (P.globalRecoveredKernelEdgeCoordinateEquiv Q hG e) := by
    rw [← variableKernelEdgeLabelEquivOfGraphEq_trans hCast
      (hCoordinate.trans hG)]
    rw [hcastEdge]
    rw [← variableKernelEdgeLabelEquivOfGraphEq_trans hCoordinate hG]
    rw [hcoordinateEdge]
    exact P.globalRecoveredKernelEdgeCoordinateEquiv_intrinsic Q hG e
  exact hmain

/-- The fixed-kernel recovered edge permutation from the globally aligned
cast datum to the target datum is the identity. -/
theorem globalRecoveredAlignedCastDatum_recoveredKernelEdgeCoordinatePerm
    {k ell : ℕ} (hell : 0 < ell)
    (P Q : BoundedKernelPresentation k ell)
    (hG : P.2.reconstructedGraph = Q.2.reconstructedGraph) :
    (P.globalRecoveredAlignedCastDatum hell Q hG).recoveredKernelEdgeCoordinatePerm
          Q.1.toLabelledBoundedKernel Q.2
          (P.globalRecoveredAlignedCastDatum_graph_eq_target hell Q hG) =
      Equiv.refl
        (Fin Q.1.toLabelledBoundedKernel.shape.2.1.val) := by
  apply Equiv.ext
  intro f
  let gamma := P.globalRecoveredKernelEdgeCoordinateEquiv Q hG
  obtain ⟨e, rfl⟩ := gamma.surjective f
  let D := P.globalRecoveredAlignedCastDatum hell Q hG
  let hDQ :=
    P.globalRecoveredAlignedCastDatum_graph_eq_target hell Q hG
  have hintrinsic :=
    D.recoveredKernelEdgeCoordinatePerm_intrinsic
      Q.1.toLabelledBoundedKernel Q.2 hDQ (gamma e)
  have hsame :=
    P.globalRecoveredAlignedCastDatum_recoveredKernelEdge_intrinsic
      hell Q hG e
  rw [hsame] at hintrinsic
  exact ((Q.2.recoveredKernelEdgeEquiv
    Q.1.toLabelledBoundedKernel).symm.injective hintrinsic).symm

end BoundedKernelPresentation

