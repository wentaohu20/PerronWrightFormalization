import PerronWright.Probability.InitialTopologyLawDetermination
import PerronWright.Probability.GlobalPointChartSurjective
import PerronWright.Probability.CompactGlobalPointLawSubsequence
import PerronWright.Probability.CompactGlobalTestLawLimit

/-!
# The genuine unmarked global component-process law has a unique limit

The actual vague-Borel point-measure space is a proved continuous image
of the Polish compatible-chart space. Its Borel sigma algebra is
therefore genuinely generated by finite compact-support test cylinders.
Every true weak subsequential law has the already proved actual joint
test-vector law limits, so these laws are equal as actual probability
measures. The previously proved subsequence compactness then yields
full-sequence weak convergence and actual uniqueness.

The resulting law is constructed from the finite graph laws themselves;
no candidate process, vague-determination, or target-existence interface
is supplied. Brownian/excursion identification is not asserted here.
-/

open MeasureTheory Filter Topology
open scoped Classical CompactlySupported

noncomputable section
set_option maxHeartbeats 1000000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

namespace PerronWright.CompactGlobalPointLawLimit

open ComponentGlobalPointProcess LocallyFinitePointMeasureVague
open InitialTopologyLawDetermination GlobalPointChartSurjective
open CompactGlobalPointLawSubsequence CompactGlobalTestLawLimit

/-- Genuine probability laws are determined by their actual finite
joint compact-support integral laws. The Borel generation and countable
open covers used here were proved from actual chart assembly. -/
theorem probability_ext_of_finiteTestMaps
    (μ ν : ProbabilityMeasure (LocalPointMeasure PositiveSizeSurplus))
    (h : ∀ F : Finset C_c(PositiveSizeSurplus, ℝ),
      μ.map (continuous_finiteProjection (continuous_testEncoding) F).measurable.aemeasurable =
        ν.map (continuous_finiteProjection (continuous_testEncoding) F).measurable.aemeasurable) :
    μ = ν := by
  let : IsProbabilityMeasure (μ : Measure (LocalPointMeasure PositiveSizeSurplus)) := μ.property
  apply ProbabilityMeasure.toMeasure_injective
  apply ext_of_finiteProjection_map_of_hereditarilyLindelof testEncoding isInducing_testEncoding
    (μ : Measure (LocalPointMeasure PositiveSizeSurplus))
    (ν : Measure (LocalPointMeasure PositiveSizeSurplus))
  intro F
  simpa only [ProbabilityMeasure.toMeasure_map] using congrArg
    (fun θ : ProbabilityMeasure (F → ℝ) ↦ (θ : Measure (F → ℝ))) (h F)

def finiteTestLawEncoding
    (μ : ProbabilityMeasure (LocalPointMeasure PositiveSizeSurplus)) :
    (F : Finset C_c(PositiveSizeSurplus, ℝ)) → ProbabilityMeasure (F → ℝ) :=
  fun F ↦ μ.map (continuous_finiteProjection continuous_testEncoding F).measurable.aemeasurable

theorem continuous_finiteTestLawEncoding : Continuous finiteTestLawEncoding :=
  continuous_pi (fun F ↦ ProbabilityMeasure.continuous_map
    (continuous_finiteProjection continuous_testEncoding F))

theorem finiteTestLawEncoding_injective : Function.Injective finiteTestLawEncoding :=
  fun μ ν h ↦ probability_ext_of_finiteTestMaps μ ν (fun F ↦ congrFun h F)

/-- Hausdorffness of the actual global weak-law topology follows from
proved test-law determination, without assuming global Polishness. -/
instance globalPointLaw_t2 : T2Space (ProbabilityMeasure (LocalPointMeasure PositiveSizeSurplus)) :=
  T2Space.of_injective_continuous finiteTestLawEncoding_injective continuous_finiteTestLawEncoding

variable {S : Type*} [MeasurableSpace S] [MetricSpace S] [CompactSpace S] [BorelSpace S]

/-- Any two actual weak subsequential law limits coincide, not merely
their first moments or individual test integrals. -/
theorem unmarkedProcessLaw_subseq_limits_eq (M : CompactBJRModel S)
    (hM : M.IsRegularCritical) (hQP : M.QP) (lambda : ℝ)
    {I J : ℕ → ℕ} (hI : Tendsto I atTop atTop) (hJ : Tendsto J atTop atTop)
    {μ ν : ProbabilityMeasure (LocalPointMeasure PositiveSizeSurplus)}
    (hμ : Tendsto (fun k ↦ unmarkedProcessLaw M lambda (I k)) atTop (𝓝 μ))
    (hν : Tendsto (fun k ↦ unmarkedProcessLaw M lambda (J k)) atTop (𝓝 ν)) :
    μ = ν := by
  apply probability_ext_of_finiteTestMaps
  intro F
  let f : F → C_c(PositiveSizeSurplus, ℝ) := Subtype.val
  obtain ⟨θ, hθ, _⟩ := exists_unique_globalTestLaw_limit M hM hQP lambda f
  have hμf := ProbabilityMeasure.tendsto_map_of_tendsto_of_continuous
    (fun k ↦ unmarkedProcessLaw M lambda (I k)) μ hμ (continuous_testVector f)
  have hνf := ProbabilityMeasure.tendsto_map_of_tendsto_of_continuous
    (fun k ↦ unmarkedProcessLaw M lambda (J k)) ν hν (continuous_testVector f)
  change Tendsto (fun k ↦ globalTestLaw M lambda (I k) f) atTop
    (𝓝 (μ.map (continuous_testVector f).measurable.aemeasurable)) at hμf
  change Tendsto (fun k ↦ globalTestLaw M lambda (J k) f) atTop
    (𝓝 (ν.map (continuous_testVector f).measurable.aemeasurable)) at hνf
  exact (tendsto_nhds_unique hμf (hθ.comp hI)).trans
    (tendsto_nhds_unique hνf (hθ.comp hJ)).symm

/-- Actual full-sequence weak convergence of the literal unmarked
component point process on `(0, ∞) × ℕ`, for the proved `C_c`-integral
vague topology. The probability law is both genuinely constructed and
unique among all actual probability measures on the vague-Borel space.
Only the paper's regular-critical and QP model hypotheses are used. -/
theorem exists_unique_unmarkedProcessLaw_limit (M : CompactBJRModel S)
    (hM : M.IsRegularCritical) (hQP : M.QP) (lambda : ℝ) :
    ∃! ν : ProbabilityMeasure (LocalPointMeasure PositiveSizeSurplus),
      Tendsto (fun n ↦ unmarkedProcessLaw M lambda n) atTop (𝓝 ν) := by
  obtain ⟨ν, N, hN, hν⟩ := exists_unmarkedProcessLaw_subseq_limit M hM hQP lambda
  have hfull : Tendsto (fun n ↦ unmarkedProcessLaw M lambda n) atTop (𝓝 ν) := by
    apply Filter.tendsto_of_subseq_tendsto
    intro I hI
    obtain ⟨ρ, J, hJ, hρ⟩ :=
      exists_reindexed_unmarkedProcessLaw_subseq_limit M hM hQP lambda I
    have he : ρ = ν := unmarkedProcessLaw_subseq_limits_eq M hM hQP lambda
      (hI.comp hJ.tendsto_atTop) hN.tendsto_atTop hρ hν
    exact ⟨J, he ▸ hρ⟩
  refine ⟨ν, hfull, ?_⟩
  intro ρ hρ
  exact unmarkedProcessLaw_subseq_limits_eq M hM hQP lambda
    tendsto_id tendsto_id hρ hfull

/-- The unique law constructed from the genuine finite graph sequence.
This is not a separately supplied candidate process law. -/
def unmarkedProcessLimitLaw (M : CompactBJRModel S) (hM : M.IsRegularCritical)
    (hQP : M.QP) (lambda : ℝ) : ProbabilityMeasure (LocalPointMeasure PositiveSizeSurplus) :=
  (exists_unique_unmarkedProcessLaw_limit M hM hQP lambda).choose

theorem tendsto_unmarkedProcessLimitLaw (M : CompactBJRModel S) (hM : M.IsRegularCritical)
    (hQP : M.QP) (lambda : ℝ) :
    Tendsto (fun n ↦ unmarkedProcessLaw M lambda n) atTop
      (𝓝 (unmarkedProcessLimitLaw M hM hQP lambda)) :=
  (exists_unique_unmarkedProcessLaw_limit M hM hQP lambda).choose_spec.1

end PerronWright.CompactGlobalPointLawLimit
